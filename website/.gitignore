# Manim (Python) build artifacts — rendered clips go to public/anim/
anim/__pycache__/
anim/media/
anim/_*.py
__pycache__/
*.pyc

# src/data here is the stage/narrative config, NOT the ML dataset dir the
# repo-root .gitignore excludes via "data/". Force it back into tracking.
!src/data/

# Rendered media is NOT in git: public/anim lives in R2 (deploy-media.sh) and
# on the render machine; anim/masters are regenerable from the scene files.
# The committed .anim-version carries the media content hash for CI builds.
public/anim/
anim/masters/
